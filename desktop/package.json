{
  "name": "qq-agent-desktop",
  "productName": "QQAgentDesktop",
  "version": "0.3.0",
  "description": "QQ Agent 桌面壳（Electron）：ME_Agent 仓库 desktop/ 子目录形态 · 仓库根双击即达（启动桌面客户端.bat）· 全链路无 cmd 窗口 · 后端就绪联动启动（POST /system/boot 触发第三方程序编排，404 静默降级）· 托盘/原生通知体现编排进度 · 原生窗口加载控制台 · 托盘常驻 · 后端生命周期（探测/拉起/附加）",
  "main": "main.js",
  "author": "ME Agent · 设计匠人",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "smoke:demo": "electron . --smoke --mode=demo",
    "smoke:live": "electron . --smoke --mode=live",
    "test:backend": "node test/test-backend-manager.js",
    "test:boot": "node test/test-boot-orchestrator.js",
    "test:bat": "node test/test-launcher-bat.js",
    "test": "node test/test-backend-manager.js && node test/test-boot-orchestrator.js && node test/test-launcher-bat.js",
    "icon": "node scripts/gen-icon.js",
    "sync-console": "node scripts/sync-console.js",
    "package-win": "electron-packager . QQAgentDesktop --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"(^|/)node_modules($|/)|(^|/)dist($|/)|(^|/)\\.git($|/)\"",
    "package-linux": "electron-packager . QQAgentDesktop --platform=linux --arch=x64 --out=dist --overwrite --ignore=\"(^|/)node_modules($|/)|(^|/)dist($|/)|(^|/)\\.git($|/)\""
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-packager": "^17.1.2"
  }
}
